{
  "version": 3,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node",
      "config": { "maxLambdaSize": "50mb" }
    },
    {
      "src": "dist/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/dist/static/$1" },
    { "src": "/(.*\\.(js|css|png|jpg|svg|ico))", "dest": "/dist/static/$1" },
    { "src": "/.*", "dest": "/src/index.ts" }
  ],
  "functions": {
    "src/index.ts": {
      "runtime": "nodejs18.x",
      "memory": 512,
      "maxDuration": 10
    }
  }
}

{
  "version": 2,
  "builds": [
    { "src": "src/index.ts", "use": "@vercel/node@2.1.3" },
    { "src": "dist/static/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/dist/static/$1" },
    { "src": "\/(.*\\.(js|css|png|jpg|svg|ico))", "dest": "/dist/static/$1" },
    { "src": "/.*", "dest": "/src/index.ts" }
  ]
}
